{
  "stack_id": "dart",
  "commands": {
    "install": "dart pub get",
    "dev": "dart run",
    "build": "dart compile exe bin/main.dart",
    "test": "dart test",
    "lint": "dart analyze",
    "lint_fix": "dart fix --apply",
    "simplify": null,
    "perf": null,
    "security": null,
    "integration": "dart test test/integration/",
    "run": "dart run"
  },
  "e2e_by_project_type": {
    "web": null,
    "api": null,
    "cli": null,
    "library": null,
    "mobile": null,
    "default": null
  },
  "load_by_project_type": {
    "default": null
  },
  "default_port": 8080,
  "manifest_files": [
    "pubspec.yaml",
    "pubspec.lock"
  ],
  "deps_dir": ".dart_tool"
}
